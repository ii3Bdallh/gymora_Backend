                 {
                     "name":  "Switch Gym",
                     "request":  {
                                     "description":  "Switches the current active gym workspace for the authenticated user and returns fresh tokens.\n\n### Request Fields\n\n| Field | Type | Required | Description |\n| :--- | :--- | :--- | :--- |\n| `gymId` | `int` | Yes | Target gym ID to switch to |\n| `accessToken` | `string` | Yes | Current access token |\n| `refreshToken` | `string` | Yes | Current refresh token |\n\nNote: This endpoint lives on the Auth controller.",
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\n  \"gymId\": {{gymId}},\n  \"accessToken\": \"{{token}}\",\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
                                              },
                                     "url":  {
                                                 "raw":  "{{baseUrl}}/api/Auth/switch",
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "path":  [
                                                              "api",
                                                              "Auth",
                                                              "switch"
                                                          ]
                                             }
                                 },
