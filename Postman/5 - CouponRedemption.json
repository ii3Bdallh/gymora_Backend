                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "path":  [
                                                              "api",
                                                              "CouponRedemption",
                                                              "{{couponRedemptionId}}"
                                                          ]
                                             }
                                 },
                     "response":  [

                                  ]
                 }
             ],
