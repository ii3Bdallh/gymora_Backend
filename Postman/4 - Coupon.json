                                                  "raw":  "{\n  \"code\": \"SUMMER50\",\n  \"name\": \"Summer Discount\",\n  \"description\": \"50% off summer pass\",\n  \"discountType\": 1,\n  \"discountValue\": 50.0,\n  \"maxDiscountAmount\": 100.0,\n  \"minimumPurchaseAmount\": 200.0,\n  \"usageLimit\": 100,\n  \"validFrom\": \"2026-07-22T00:00:00Z\",\n  \"validTo\": \"2026-08-22T00:00:00Z\",\n  \"isFirstPurchaseOnly\": false\n}"
