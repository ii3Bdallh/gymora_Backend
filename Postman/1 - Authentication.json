                  {
                      "name":  "Login (Owner)",
                      "event":  [
                                    {
                                        "listen":  "test",
                                        "script":  {
                                                       "exec":  [
                                                                    "pm.test(\"Status code is 200\", function () {",
                                                                    "    pm.response.to.have.status(200);",
                                                                    "});",
                                                                    "var jsonData = pm.response.json();",
                                                                    "pm.test(\"Tokens are saved to environment\", function () {",
                                                                    "    pm.expect(jsonData.isSuccess).to.eql(true);",
                                                                    "    if (jsonData.data \u0026\u0026 jsonData.data.accessToken) {",
                                                                    "        var accessToken = jsonData.data.accessToken;",
                                                                    "        var refreshToken = jsonData.data.refreshToken;",
                                                                    "        var userId = jsonData.data.user ? jsonData.data.user.userId : \"\";",
                                                                    "        var email = jsonData.data.user ? jsonData.data.user.email : \"\";",
                                                                    "        pm.environment.set(\"token\", accessToken);",
                                                                    "        pm.environment.set(\"refreshToken\", refreshToken);",
                                                                    "        pm.environment.set(\"accessToken\", accessToken);",
                                                                    "        pm.environment.set(\"userId\", userId);",
                                                                    "        pm.environment.set(\"email\", email);",
                                                                    "        pm.environment.set(\"owner_token\", accessToken);",
                                                                    "        pm.environment.set(\"owner_refreshToken\", refreshToken);",
                                                                    "        pm.environment.set(\"owner_userId\", userId);",
                                                                    "        pm.sendRequest({",
                                                                    "            url: pm.environment.get(\"baseUrl\") + \"/api/Auth/get-user-profile\",",
                                                                    "            method: \"GET\",",
                                                                    "            header: { \"Authorization\": \"Bearer \" + accessToken }",
                                                                    "        }, function (err, res) {",
                                                                    "            if (err) { console.log(\"Profile fetch failed: \" + err); return; }",
                                                                    "            var profile = res.json();",
                                                                    "            var roles = profile \u0026\u0026 profile.data \u0026\u0026 profile.data.roles ? profile.data.roles : [];",
                                                                    "            var isSuperAdmin = roles.indexOf(\"SuperAdmin\") !== -1;",
                                                                    "            pm.environment.set(\"role\", isSuperAdmin ? \"SuperAdmin\" : \"User\");",
                                                                    "            pm.environment.set(\"accessSuperAdminToken\", isSuperAdmin ? accessToken : \"\");",
                                                                    "            pm.environment.set(\"refreshSuperAdminToken\", isSuperAdmin ? refreshToken : \"\");",
                                                                    "            pm.environment.set(\"superAdminEmail\", isSuperAdmin ? email : \"\");",
                                                                    "            pm.environment.set(\"accessUserToken\", isSuperAdmin ? \"\" : accessToken);",
                                                                    "            pm.environment.set(\"refreshUserToken\", isSuperAdmin ? \"\" : refreshToken);",
                                                                    "            pm.environment.set(\"userEmail\", isSuperAdmin ? \"\" : email);",
                                                                    "        });",
                                                                    "    }",
                                                                    "});"
                                                                ],
                                                       "type":  "text/javascript"
                                                   }
                                    }
                                ],
