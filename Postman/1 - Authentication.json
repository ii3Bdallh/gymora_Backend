                 {
                     "name":  "Login (Owner)",
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "exec":  [
                                                                   "pm.test(\"Status code is 200\", function () {",
                                                                   "    pm.response.to.have.status(200);",
                                                                   "});",
                                                                   "pm.test(\"Token is saved to environment\", function () {",
                                                                   "    var jsonData = pm.response.json();",
                                                                   "    pm.expect(jsonData.succeeded).to.eql(true);",
                                                                   "    if (jsonData.data \u0026\u0026 jsonData.data.token) {",
                                                                   "        pm.environment.set(\"owner_token\", jsonData.data.token);",
                                                                   "        pm.environment.set(\"owner_refreshToken\", jsonData.data.refreshToken);",
                                                                   "        pm.environment.set(\"token\", jsonData.data.token);",
                                                                   "        pm.environment.set(\"refreshToken\", jsonData.data.refreshToken);",
                                                                   "    }",
                                                                   "});"
                                                               ],
                                                      "type":  "text/javascript"
                                                  }
                                   }
                               ],
                     "request":  {
                                     "auth":  {
                                                  "type":  "noauth"
                                              },
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
