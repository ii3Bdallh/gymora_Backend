                  "});",
                  "",
                  "pm.test(\"Response is success\", () => {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.isSuccess).to.be.true;",
                  "    pm.expect(json.data).to.be.an('object');",
                  "});",
                  "",
                  "pm.test(\"Login response has all required fields\", () => {",
                  "    var data = pm.response.json().data;",
                  "    pm.expect(data.id).to.be.a('number');",
                  "    pm.expect(data.email).to.be.a('string');",
                  "    pm.expect(data.personName).to.be.a('string');",
                  "    pm.expect(data.token).to.be.a('string');",
                  "    pm.expect(data.expiresIn).to.be.a('number');",
                  "    pm.expect(data.refreshtoken).to.be.a('string');",
                  "    pm.expect(data.roles).to.be.an('array');",
                  "    pm.expect(data.refreshTokenExpirationDate).to.be.a('string');",
                  "});",
                  "",
                  "if (pm.response.code === 200 && pm.response.json().isSuccess) {",
                  "    var data = pm.response.json().data;",
                  "    pm.collectionVariables.set(\"accessToken\", data.token);",
                  "    pm.collectionVariables.set(\"refreshToken\", data.refreshtoken);",
                  "    pm.collectionVariables.set(\"currentUserId\", data.id.toString());",
                  "}"
                ],
                "type": "text/javascript"
              }
