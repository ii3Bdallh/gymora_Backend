        {
            "name": "Verify Password OTP",
            "description": "Verifies the 6-digit reset code sent after `forgot-password`. Stores the returned `resetToken` for the `Reset Password` request.\n\n### Request Fields (`VerifyOtpRequestDto`)\n\n| Field | Type | Required | Description |\n| :--- | :--- | :--- | :--- |\n| `email` | `string` | Yes | Account email |\n| `code` | `string` | Yes | Exactly 6 digits |\n\nReturns `Result<VerifyOtpResponseDto>` containing `resetToken` and `message`.",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Status code is 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "var jsonData = pm.response.json();",
                            "if (jsonData.data && jsonData.data.resetToken) {",
                            "    pm.environment.set(\"resetToken\", jsonData.data.resetToken);",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"{{user1_email}}\",\n  \"code\": \"123456\"\n}"
                },
                "url": {
