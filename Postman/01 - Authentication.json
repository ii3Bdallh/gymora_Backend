                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"gymId\": {{gymId}},\n  \"accessToken\": \"{{superAdmin_token}}\",\n  \"refreshToken\": \"{{superAdmin_refreshToken}}\"\n}"
                },
