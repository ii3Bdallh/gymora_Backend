        {
            "name": "Verify Email OTP",
            "description": "Confirms the account email using the 6-digit code sent at registration.\n\n### Request Fields (`VerifyOtpRequestDto`)\n\n| Field | Type | Required | Description |\n| :--- | :--- | :--- | :--- |\n| `email` | `string` | Yes | Account email |\n| `code` | `string` | Yes | Exactly 6 digits |\n\nReturns `Result<string>` — message \"Email verified successfully.\"",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"{{user1_email}}\",\n  \"code\": \"123456\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/Auth/verify-email-otp",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "Auth",
                        "verify-email-otp"
                    ]
                }
            },
            "response": []
        },
