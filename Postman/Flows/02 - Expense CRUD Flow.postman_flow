{
    "info": {
        "name": "Expense CRUD & Security Flow",
        "description": "Tests the complete Expense lifecycle: Create → Read → Update → Delete → Verify 404. Gym-scoped via BaseGymRepo.",
        "schema": "https://schema.getpostman.com/flow/v1/flow.json"
    },
    "flow": [
        { "id": "start", "type": "start", "name": "Start", "next": "create" },
        {
            "id": "create", "type": "http", "name": "1. Create Expense",
            "request": {
                "method": "POST", "url": "{{baseUrl}}/api/Expenses/Create",
                "headers": { "Authorization": "Bearer {{user1_token}}", "Content-Type": "application/json" },
                "body": { "expenseCategory": 3, "amount": 2500.00, "paymentMethod": 3, "referenceNumber": "FLOW-EXP-001", "description": "Flow test expense", "expenseDate": "2026-08-13T00:00:00Z" }
            },
            "next": "check-create"
        },
        { "id": "check-create", "type": "condition", "name": "201?", "conditions": [{ "left": "{{create.response.status}}", "operator": "equals", "right": "201" }], "true_next": "capture", "false_next": "fail" },
        { "id": "capture", "type": "set-variable", "name": "Capture ID", "scope": "collection", "variables": [{ "key": "lastExpenseId", "value": "{{create.response.body.data.id}}" }], "next": "read" },
        {
            "id": "read", "type": "http", "name": "2. Read Expense",
            "request": { "method": "GET", "url": "{{baseUrl}}/api/Expenses/{{lastExpenseId}}", "headers": { "Authorization": "Bearer {{user1_token}}" } },
            "next": "check-read"
        },
        { "id": "check-read", "type": "condition", "name": "200?", "conditions": [{ "left": "{{read.response.status}}", "operator": "equals", "right": "200" }], "true_next": "update", "false_next": "fail" },
        {
            "id": "update", "type": "http", "name": "3. Update Expense",
            "request": {
                "method": "PUT", "url": "{{baseUrl}}/api/Expenses/{{lastExpenseId}}",
                "headers": { "Authorization": "Bearer {{user1_token}}", "Content-Type": "application/json" },
                "body": { "expenseCategory": 4, "amount": 3000.00, "paymentMethod": 3, "referenceNumber": "FLOW-EXP-001-UPD", "description": "Updated", "expenseDate": "2026-08-13T00:00:00Z" }
            },
            "next": "check-update"
        },
        { "id": "check-update", "type": "condition", "name": "200?", "conditions": [{ "left": "{{update.response.status}}", "operator": "equals", "right": "200" }], "true_next": "delete", "false_next": "fail" },
        { "id": "delete", "type": "http", "name": "4. Delete Expense", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/Expenses/{{lastExpenseId}}", "headers": { "Authorization": "Bearer {{user1_token}}" } }, "next": "check-delete" },
        { "id": "check-delete", "type": "condition", "name": "200?", "conditions": [{ "left": "{{delete.response.status}}", "operator": "equals", "right": "200" }], "true_next": "verify-404", "false_next": "fail" },
        { "id": "verify-404", "type": "http", "name": "5. Verify 404", "request": { "method": "GET", "url": "{{baseUrl}}/api/Expenses/{{lastExpenseId}}", "headers": { "Authorization": "Bearer {{user1_token}}" } }, "next": "check-404" },
        { "id": "check-404", "type": "condition", "name": "404?", "conditions": [{ "left": "{{verify-404.response.status}}", "operator": "equals", "right": "404" }], "true_next": "pass", "false_next": "fail" },
        { "id": "pass", "type": "log", "name": "PASSED", "message": "[Expense CRUD] Create→Read→Update→Delete→404 all passed" },
        { "id": "fail", "type": "log", "name": "FAILED", "message": "[Expense CRUD] Flow failed" },
        { "id": "end", "type": "end", "name": "End" }
    ]
}
