{
    "info": {
        "name": "User Story: Workout Content Publishing Flow",
        "description": "Complete business flow: Owner creates WorkoutPlan (with Sessions & Exercises) → Owner creates Session → Owner batch-creates SessionExercises → SuperAdmin approves WorkoutPlan → SuperAdmin approves Session → Assign plan to Member → Verify assignment. Tests the full content creation and publishing journey.",
        "schema": "https://schema.getpostman.com/flow/v1/flow.json"
    },
    "flow": [
        { "id": "start", "type": "start", "name": "Start", "next": "create-workout-plan" },
        {
            "id": "create-workout-plan", "type": "http", "name": "1. Create WorkoutPlan",
            "request": {
                "method": "POST", "url": "{{baseUrl}}/api/WorkoutPlans/Create",
                "headers": { "Authorization": "Bearer {{user1_token}}", "Content-Type": "application/json" },
                "body": {
                    "planName": "Flow Content Plan",
                    "description": "Full workout plan with sessions",
                    "sessions": [
                        { "dayNumber": 1, "sessionName": "Push Day", "exercises": [] },
                        { "dayNumber": 2, "sessionName": "Pull Day", "exercises": [] }
                    ]
                }
            },
            "next": "check-plan"
        },
        { "id": "check-plan", "type": "condition", "name": "201?", "conditions": [{ "left": "{{create-workout-plan.response.status}}", "operator": "equals", "right": "201" }], "true_next": "capture-plan", "false_next": "fail" },
        { "id": "capture-plan", "type": "set-variable", "name": "Capture Plan ID", "scope": "collection", "variables": [{ "key": "lastWorkoutPlanId", "value": "{{create-workout-plan.response.body.data.id}}" }], "next": "create-session" },
        {
            "id": "create-session", "type": "http", "name": "2. Create Session",
            "request": {
                "method": "POST", "url": "{{baseUrl}}/api/Sessions/Create",
                "headers": { "Authorization": "Bearer {{user1_token}}", "Content-Type": "application/json" },
                "body": { "workoutPlanId": "{{lastWorkoutPlanId}}", "dayNumber": 3, "sessionName": "Leg Day", "exercises": [] }
            },
            "next": "check-session"
        },
        { "id": "check-session", "type": "condition", "name": "201?", "conditions": [{ "left": "{{create-session.response.status}}", "operator": "equals", "right": "201" }], "true_next": "capture-session", "false_next": "fail" },
        { "id": "capture-session", "type": "set-variable", "name": "Capture Session ID", "scope": "collection", "variables": [{ "key": "lastSessionId", "value": "{{create-session.response.body.data.id}}" }], "next": "batch-exercises" },
        {
            "id": "batch-exercises", "type": "http", "name": "3. Batch Create SessionExercises",
            "request": {
                "method": "POST", "url": "{{baseUrl}}/api/SessionExercises/Batch",
                "headers": { "Authorization": "Bearer {{user1_token}}", "Content-Type": "application/json" },
                "body": [
                    { "sessionId": "{{lastSessionId}}", "exerciseId": null, "exerciseName": "Barbell Squat", "sets": 4, "reps": 8, "weightKg": 60.0, "restSeconds": 120, "notes": "Deep squat", "orderIndex": 0 },
                    { "sessionId": "{{lastSessionId}}", "exerciseId": null, "exerciseName": "Leg Press", "sets": 3, "reps": 12, "weightKg": 100.0, "restSeconds": 90, "notes": null, "orderIndex": 1 }
                ]
            },
            "next": "check-exercises"
        },
        { "id": "check-exercises", "type": "condition", "name": "201?", "conditions": [{ "left": "{{batch-exercises.response.status}}", "operator": "equals", "right": "201" }], "true_next": "approve-plan", "false_next": "fail" },
        { "id": "approve-plan", "type": "http", "name": "4. SuperAdmin Approves WorkoutPlan", "request": { "method": "POST", "url": "{{baseUrl}}/api/WorkoutPlans/{{lastWorkoutPlanId}}/Approve", "headers": { "Authorization": "Bearer {{superAdmin_token}}" } }, "next": "check-approve-plan" },
        { "id": "check-approve-plan", "type": "condition", "name": "200?", "conditions": [{ "left": "{{approve-plan.response.status}}", "operator": "equals", "right": "200" }], "true_next": "approve-session", "false_next": "fail" },
        { "id": "approve-session", "type": "http", "name": "5. SuperAdmin Approves Session", "request": { "method": "POST", "url": "{{baseUrl}}/api/Sessions/{{lastSessionId}}/Approve", "headers": { "Authorization": "Bearer {{superAdmin_token}}" } }, "next": "check-approve-session" },
        { "id": "check-approve-session", "type": "condition", "name": "200?", "conditions": [{ "left": "{{approve-session.response.status}}", "operator": "equals", "right": "200" }], "true_next": "assign-plan", "false_next": "fail" },
        {
            "id": "assign-plan", "type": "http", "name": "6. Assign Plan to Member",
            "request": {
                "method": "POST", "url": "{{baseUrl}}/api/MemberWorkoutPlans/Create",
                "headers": { "Authorization": "Bearer {{user1_token}}", "Content-Type": "application/json" },
                "body": { "workoutPlanId": "{{lastWorkoutPlanId}}", "memberId": "{{gymPersonId}}", "goal": "Get stronger", "startDate": "2026-08-13T00:00:00Z", "endDate": "2026-11-13T00:00:00Z" }
            },
            "next": "check-assign"
        },
        { "id": "check-assign", "type": "condition", "name": "201?", "conditions": [{ "left": "{{assign-plan.response.status}}", "operator": "equals", "right": "201" }], "true_next": "pass", "false_next": "fail" },
        { "id": "pass", "type": "log", "name": "PASSED", "message": "[User Story: Content Publishing] CreatePlan→CreateSession→BatchExercises→ApprovePlan→ApproveSession→AssignToMember all passed" },
        { "id": "fail", "type": "log", "name": "FAILED", "message": "[User Story: Content Publishing] Flow failed at one of the steps" },
        { "id": "end", "type": "end", "name": "End" }
    ]
}
