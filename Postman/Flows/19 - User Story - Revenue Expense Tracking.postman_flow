{
    "info": {
        "name": "User Story: Revenue & Expense Tracking Flow",
        "description": "Complete business flow: Create Revenue → Create Expense → Generate Revenue Report → Generate Expense Report → Verify totals. Tests the full financial tracking journey.",
        "schema": "https://schema.getpostman.com/flow/v1/flow.json"
    },
    "flow": [
        { "id": "start", "type": "start", "name": "Start", "next": "create-revenue-1" },
        {
            "id": "create-revenue-1", "type": "http", "name": "1. Create Revenue (Membership Fee)",
            "request": {
                "method": "POST", "url": "{{baseUrl}}/api/Revenues/Create",
                "headers": { "Authorization": "Bearer {{user1_token}}", "Content-Type": "application/json" },
                "body": { "revenueCategory": 0, "amount": 499.00, "paymentMethod": 0, "referenceNumber": "REV-MEM-001", "description": "Monthly membership", "revenueDate": "2026-08-01T00:00:00Z" }
            },
            "next": "check-rev1"
        },
        { "id": "check-rev1", "type": "condition", "name": "201?", "conditions": [{ "left": "{{create-revenue-1.response.status}}", "operator": "equals", "right": "201" }], "true_next": "create-revenue-2", "false_next": "fail" },
        {
            "id": "create-revenue-2", "type": "http", "name": "2. Create Revenue (Personal Training)",
            "request": {
                "method": "POST", "url": "{{baseUrl}}/api/Revenues/Create",
                "headers": { "Authorization": "Bearer {{user1_token}}", "Content-Type": "application/json" },
                "body": { "revenueCategory": 1, "amount": 200.00, "paymentMethod": 1, "referenceNumber": "REV-PT-001", "description": "PT session", "revenueDate": "2026-08-05T00:00:00Z" }
            },
            "next": "check-rev2"
        },
        { "id": "check-rev2", "type": "condition", "name": "201?", "conditions": [{ "left": "{{create-revenue-2.response.status}}", "operator": "equals", "right": "201" }], "true_next": "create-expense", "false_next": "fail" },
        {
            "id": "create-expense", "type": "http", "name": "3. Create Expense (Rent)",
            "request": {
                "method": "POST", "url": "{{baseUrl}}/api/Expenses/Create",
                "headers": { "Authorization": "Bearer {{user1_token}}", "Content-Type": "application/json" },
                "body": { "expenseCategory": 0, "amount": 5000.00, "paymentMethod": 3, "referenceNumber": "EXP-RENT-001", "description": "Monthly rent", "expenseDate": "2026-08-01T00:00:00Z" }
            },
            "next": "check-exp"
        },
        { "id": "check-exp", "type": "condition", "name": "201?", "conditions": [{ "left": "{{create-expense.response.status}}", "operator": "equals", "right": "201" }], "true_next": "create-expense-2", "false_next": "fail" },
        {
            "id": "create-expense-2", "type": "http", "name": "4. Create Expense (Equipment)",
            "request": {
                "method": "POST", "url": "{{baseUrl}}/api/Expenses/Create",
                "headers": { "Authorization": "Bearer {{user1_token}}", "Content-Type": "application/json" },
                "body": { "expenseCategory": 2, "amount": 1500.00, "paymentMethod": 1, "referenceNumber": "EXP-EQ-001", "description": "New dumbbells", "expenseDate": "2026-08-10T00:00:00Z" }
            },
            "next": "check-exp2"
        },
        { "id": "check-exp2", "type": "condition", "name": "201?", "conditions": [{ "left": "{{create-expense-2.response.status}}", "operator": "equals", "right": "201" }], "true_next": "revenue-report", "false_next": "fail" },
        { "id": "revenue-report", "type": "http", "name": "5. Get Revenue Report", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/gyms/{{gymId}}/finances/reports/revenue?fromDate=2026-01-01T00:00:00Z&toDate=2026-12-31T23:59:59Z", "headers": { "Authorization": "Bearer {{user1_token}}" } }, "next": "check-rev-report" },
        { "id": "check-rev-report", "type": "condition", "name": "200?", "conditions": [{ "left": "{{revenue-report.response.status}}", "operator": "equals", "right": "200" }], "true_next": "expense-report", "false_next": "fail" },
        { "id": "expense-report", "type": "http", "name": "6. Get Expense Report", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/gyms/{{gymId}}/finances/reports/expense?fromDate=2026-01-01T00:00:00Z&toDate=2026-12-31T23:59:59Z", "headers": { "Authorization": "Bearer {{user1_token}}" } }, "next": "check-exp-report" },
        { "id": "check-exp-report", "type": "condition", "name": "200?", "conditions": [{ "left": "{{expense-report.response.status}}", "operator": "equals", "right": "200" }], "true_next": "verify-revenue", "false_next": "fail" },
        { "id": "verify-revenue", "type": "condition", "name": "TotalRevenue >= 699?", "conditions": [{ "left": "{{revenue-report.response.body.data.totalRevenue}}", "operator": "greater_equals", "right": "699" }], "true_next": "verify-expense", "false_next": "fail" },
        { "id": "verify-expense", "type": "condition", "name": "TotalExpense >= 3000?", "conditions": [{ "left": "{{expense-report.response.body.data.totalExpense}}", "operator": "greater_equals", "right": "3000" }], "true_next": "pass", "false_next": "fail" },
        { "id": "pass", "type": "log", "name": "PASSED", "message": "[User Story: Financial Tracking] CreateRevenue(2)→CreateExpense(2)→RevenueReport→ExpenseReport→VerifyTotals all passed" },
        { "id": "fail", "type": "log", "name": "FAILED", "message": "[User Story: Financial Tracking] Flow failed at one of the steps" },
        { "id": "end", "type": "end", "name": "End" }
    ]
}
