{
    "info": {
        "name": "Workout Plan CRUD & Security Flow",
        "description": "Tests WorkoutPlan lifecycle: Owner creates (with sessions) → Read → SuperAdmin approves → SuperAdmin deletes. User-scoped via CreatedById.",
        "schema": "https://schema.getpostman.com/flow/v1/flow.json"
    },
    "flow": [
        { "id": "start", "type": "start", "name": "Start", "next": "create" },
        {
            "id": "create", "type": "http", "name": "1. Create WorkoutPlan with Sessions",
            "request": {
                "method": "POST", "url": "{{baseUrl}}/api/WorkoutPlans/Create",
                "headers": { "Authorization": "Bearer {{user1_token}}", "Content-Type": "application/json" },
                "body": {
                    "planName": "Flow Test Plan",
                    "description": "Test plan with sessions",
                    "sessions": [
                        { "dayNumber": 1, "sessionName": "Day 1 - Push", "exercises": [] },
                        { "dayNumber": 2, "sessionName": "Day 2 - Pull", "exercises": [] }
                    ]
                }
            },
            "next": "check-create"
        },
        { "id": "check-create", "type": "condition", "name": "201?", "conditions": [{ "left": "{{create.response.status}}", "operator": "equals", "right": "201" }], "true_next": "capture", "false_next": "fail" },
        { "id": "capture", "type": "set-variable", "name": "Capture ID", "scope": "collection", "variables": [{ "key": "lastWorkoutPlanId", "value": "{{create.response.body.data.id}}" }], "next": "read" },
        { "id": "read", "type": "http", "name": "2. Read WorkoutPlan", "request": { "method": "GET", "url": "{{baseUrl}}/api/WorkoutPlans/{{lastWorkoutPlanId}}", "headers": { "Authorization": "Bearer {{user1_token}}" } }, "next": "check-read" },
        { "id": "check-read", "type": "condition", "name": "200?", "conditions": [{ "left": "{{read.response.status}}", "operator": "equals", "right": "200" }], "true_next": "verify-sessions", "false_next": "fail" },
        { "id": "verify-sessions", "type": "condition", "name": "Has 2 sessions?", "conditions": [{ "left": "{{read.response.body.data.sessions.length}}", "operator": "equals", "right": "2" }], "true_next": "sa-approve", "false_next": "fail" },
        { "id": "sa-approve", "type": "http", "name": "3. SuperAdmin Approves", "request": { "method": "POST", "url": "{{baseUrl}}/api/WorkoutPlans/{{lastWorkoutPlanId}}/Approve", "headers": { "Authorization": "Bearer {{superAdmin_token}}" } }, "next": "check-approve" },
        { "id": "check-approve", "type": "condition", "name": "200?", "conditions": [{ "left": "{{sa-approve.response.status}}", "operator": "equals", "right": "200" }], "true_next": "sa-update", "false_next": "fail" },
        { "id": "sa-update", "type": "http", "name": "4. SuperAdmin Updates", "request": { "method": "PUT", "url": "{{baseUrl}}/api/WorkoutPlans/{{lastWorkoutPlanId}}", "headers": { "Authorization": "Bearer {{superAdmin_token}}", "Content-Type": "application/json" }, "body": { "planName": "Flow Test Plan (Updated)", "description": "Updated" } }, "next": "check-update" },
        { "id": "check-update", "type": "condition", "name": "200?", "conditions": [{ "left": "{{sa-update.response.status}}", "operator": "equals", "right": "200" }], "true_next": "sa-delete", "false_next": "fail" },
        { "id": "sa-delete", "type": "http", "name": "5. SuperAdmin Deletes", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/WorkoutPlans/{{lastWorkoutPlanId}}", "headers": { "Authorization": "Bearer {{superAdmin_token}}" } }, "next": "check-delete" },
        { "id": "check-delete", "type": "condition", "name": "200?", "conditions": [{ "left": "{{sa-delete.response.status}}", "operator": "equals", "right": "200" }], "true_next": "pass", "false_next": "fail" },
        { "id": "pass", "type": "log", "name": "PASSED", "message": "[WorkoutPlan CRUD] Create→Read→Approve→Update→Delete all passed" },
        { "id": "fail", "type": "log", "name": "FAILED", "message": "[WorkoutPlan CRUD] Flow failed" },
        { "id": "end", "type": "end", "name": "End" }
    ]
}
