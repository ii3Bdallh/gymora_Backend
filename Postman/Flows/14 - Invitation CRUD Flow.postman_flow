{
    "info": {
        "name": "Invitation CRUD Flow",
        "description": "Tests Invitation lifecycle: Owner creates → Read → Member accepts → Owner cancels. Gym-scoped.",
        "schema": "https://schema.getpostman.com/flow/v1/flow.json"
    },
    "flow": [
        { "id": "start", "type": "start", "name": "Start", "next": "create" },
        {
            "id": "create", "type": "http", "name": "1. Create Invitation",
            "request": {
                "method": "POST", "url": "{{baseUrl}}/api/Invitation/Create",
                "headers": { "Authorization": "Bearer {{user1_token}}", "Content-Type": "application/json" },
                "body": { "userId": 5, "gymRole": 10, "membership": { "membershipPlanId": "{{membershipPlanId}}", "discountAmount": 0 } }
            },
            "next": "check-create"
        },
        { "id": "check-create", "type": "condition", "name": "200?", "conditions": [{ "left": "{{create.response.status}}", "operator": "equals", "right": "200" }], "true_next": "capture", "false_next": "fail" },
        { "id": "capture", "type": "set-variable", "name": "Capture ID", "scope": "collection", "variables": [{ "key": "lastInvitationId", "value": "{{create.response.body.data.id}}" }], "next": "read" },
        { "id": "read", "type": "http", "name": "2. Read By Id", "request": { "method": "GET", "url": "{{baseUrl}}/api/Invitation/{{lastInvitationId}}", "headers": { "Authorization": "Bearer {{user1_token}}" } }, "next": "check-read" },
        { "id": "check-read", "type": "condition", "name": "200?", "conditions": [{ "left": "{{read.response.status}}", "operator": "equals", "right": "200" }], "true_next": "paged", "false_next": "fail" },
        { "id": "paged", "type": "http", "name": "3. Get Paged Invitations", "request": { "method": "POST", "url": "{{baseUrl}}/api/Invitation", "headers": { "Authorization": "Bearer {{user1_token}}", "Content-Type": "application/json" }, "body": { "pageNumber": 1, "pageSize": 10, "orderBy": "Id", "orderDirection": "asc" } }, "next": "check-paged" },
        { "id": "check-paged", "type": "condition", "name": "200?", "conditions": [{ "left": "{{paged.response.status}}", "operator": "equals", "right": "200" }], "true_next": "my-invitations", "false_next": "fail" },
        { "id": "my-invitations", "type": "http", "name": "4. Get My Invitations", "request": { "method": "POST", "url": "{{baseUrl}}/api/Invitation/my-invitations", "headers": { "Authorization": "Bearer {{user2_token}}", "Content-Type": "application/json" }, "body": { "pageNumber": 1, "pageSize": 10, "orderBy": "Id", "orderDirection": "asc" } }, "next": "check-my" },
        { "id": "check-my", "type": "condition", "name": "200?", "conditions": [{ "left": "{{my-invitations.response.status}}", "operator": "equals", "right": "200" }], "true_next": "cancel", "false_next": "fail" },
        { "id": "cancel", "type": "http", "name": "5. Cancel Invitation", "request": { "method": "POST", "url": "{{baseUrl}}/api/Invitation/cancel/{{lastInvitationId}}", "headers": { "Authorization": "Bearer {{user1_token}}" } }, "next": "check-cancel" },
        { "id": "check-cancel", "type": "condition", "name": "200?", "conditions": [{ "left": "{{cancel.response.status}}", "operator": "equals", "right": "200" }], "true_next": "pass", "false_next": "fail" },
        { "id": "pass", "type": "log", "name": "PASSED", "message": "[Invitation CRUD] Create→Read→Paged→MyInvitations→Cancel all passed" },
        { "id": "fail", "type": "log", "name": "FAILED", "message": "[Invitation CRUD] Flow failed" },
        { "id": "end", "type": "end", "name": "End" }
    ]
}
