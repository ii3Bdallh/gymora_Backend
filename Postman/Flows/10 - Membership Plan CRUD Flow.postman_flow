{
    "info": {
        "name": "Membership Plan CRUD Flow",
        "description": "Tests MembershipPlan lifecycle: Owner creates → Read → Update → Delete. Gym-scoped.",
        "schema": "https://schema.getpostman.com/flow/v1/flow.json"
    },
    "flow": [
        { "id": "start", "type": "start", "name": "Start", "next": "create" },
        {
            "id": "create", "type": "http", "name": "1. Create MembershipPlan",
            "request": {
                "method": "POST", "url": "{{baseUrl}}/api/MembershipPlans/Create",
                "headers": { "Authorization": "Bearer {{user1_token}}", "Content-Type": "application/json" },
                "body": { "name": "Flow Test Plan", "description": "30-day test plan", "durationDays": 30, "price": 299.00, "freezeDaysLimit": 5, "attendanceLimit": null }
            },
            "next": "check-create"
        },
        { "id": "check-create", "type": "condition", "name": "201?", "conditions": [{ "left": "{{create.response.status}}", "operator": "equals", "right": "201" }], "true_next": "capture", "false_next": "fail" },
        { "id": "capture", "type": "set-variable", "name": "Capture ID", "scope": "collection", "variables": [{ "key": "lastMembershipPlanId", "value": "{{create.response.body.data.id}}" }, { "key": "membershipPlanId", "value": "{{create.response.body.data.id}}" }], "next": "read" },
        { "id": "read", "type": "http", "name": "2. Read By Id", "request": { "method": "GET", "url": "{{baseUrl}}/api/MembershipPlans/{{lastMembershipPlanId}}", "headers": { "Authorization": "Bearer {{user1_token}}" } }, "next": "check-read" },
        { "id": "check-read", "type": "condition", "name": "200?", "conditions": [{ "left": "{{read.response.status}}", "operator": "equals", "right": "200" }], "true_next": "update", "false_next": "fail" },
        { "id": "update", "type": "http", "name": "3. Update", "request": { "method": "PUT", "url": "{{baseUrl}}/api/MembershipPlans/{{lastMembershipPlanId}}", "headers": { "Authorization": "Bearer {{user1_token}}", "Content-Type": "application/json" }, "body": { "name": "Flow Test Plan (Updated)", "description": "Updated", "durationDays": 60, "price": 499.00, "freezeDaysLimit": 10, "attendanceLimit": null } }, "next": "check-update" },
        { "id": "check-update", "type": "condition", "name": "200?", "conditions": [{ "left": "{{update.response.status}}", "operator": "equals", "right": "200" }], "true_next": "delete", "false_next": "fail" },
        { "id": "delete", "type": "http", "name": "4. Delete", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/MembershipPlans/{{lastMembershipPlanId}}", "headers": { "Authorization": "Bearer {{user1_token}}" } }, "next": "check-delete" },
        { "id": "check-delete", "type": "condition", "name": "200?", "conditions": [{ "left": "{{delete.response.status}}", "operator": "equals", "right": "200" }], "true_next": "pass", "false_next": "fail" },
        { "id": "pass", "type": "log", "name": "PASSED", "message": "[MembershipPlan CRUD] Create→Read→Update→Delete all passed" },
        { "id": "fail", "type": "log", "name": "FAILED", "message": "[MembershipPlan CRUD] Flow failed" },
        { "id": "end", "type": "end", "name": "End" }
    ]
}
