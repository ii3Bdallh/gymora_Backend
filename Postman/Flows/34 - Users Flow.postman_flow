{
    "info": {
        "name": "Users List & Roles Flow",
        "description": "Tests Users endpoints: GetAllUsers (SuperAdmin-only) → Get GotoUser (any authenticated user). Non-SuperAdmin cannot list users.",
        "schema": "https://schema.getpostman.com/flow/v1/flow.json"
    },
    "flow": [
        { "id": "start", "type": "start", "name": "Start", "next": "list-sa" },
        { "id": "list-sa", "type": "http", "name": "1. GetAllUsers (SuperAdmin)", "request": { "method": "POST", "url": "{{baseUrl}}/api/Users/GetAllUsers", "headers": { "Authorization": "Bearer {{superAdmin_token}}", "Content-Type": "application/json" }, "body": { "pageNumber": 1, "pageSize": 10, "orderBy": "Id", "orderDirection": "asc" } }, "next": "check-list-sa" },
        { "id": "check-list-sa", "type": "condition", "name": "200?", "conditions": [{ "left": "{{list-sa.response.status}}", "operator": "equals", "right": "200" }], "true_next": "non-sa", "false_next": "fail" },
        { "id": "non-sa", "type": "http", "name": "2. Non-SA GetAllUsers (403)", "request": { "method": "POST", "url": "{{baseUrl}}/api/Users/GetAllUsers", "headers": { "Authorization": "Bearer {{user1_token}}", "Content-Type": "application/json" }, "body": { "pageNumber": 1, "pageSize": 10, "orderBy": "Id", "orderDirection": "asc" } }, "next": "check-non-sa" },
        { "id": "check-non-sa", "type": "condition", "name": "403?", "conditions": [{ "left": "{{non-sa.response.status}}", "operator": "equals", "right": "403" }], "true_next": "goto-user", "false_next": "fail" },
        { "id": "goto-user", "type": "http", "name": "3. Get GotoUser (Auth)", "request": { "method": "GET", "url": "{{baseUrl}}/api/Users/GotoUser", "headers": { "Authorization": "Bearer {{user1_token}}" } }, "next": "check-goto" },
        { "id": "check-goto", "type": "condition", "name": "200?", "conditions": [{ "left": "{{goto-user.response.status}}", "operator": "equals", "right": "200" }], "true_next": "pass", "false_next": "fail" },
        { "id": "pass", "type": "log", "name": "PASSED", "message": "[Users Flow] GetAllUsers:200(SA), GetAllUsers:403(non-SA), GotoUser:200 all passed" },
        { "id": "fail", "type": "log", "name": "FAILED", "message": "[Users Flow] Flow failed" },
        { "id": "end", "type": "end", "name": "End" }
    ]
}
