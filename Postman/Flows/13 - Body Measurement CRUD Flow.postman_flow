{
    "info": {
        "name": "Body Measurement CRUD Flow",
        "description": "Tests BodyMeasurement lifecycle: Create → Read → Update → Delete. Gym-scoped.",
        "schema": "https://schema.getpostman.com/flow/v1/flow.json"
    },
    "flow": [
        { "id": "start", "type": "start", "name": "Start", "next": "create" },
        {
            "id": "create", "type": "http", "name": "1. Create BodyMeasurement",
            "request": {
                "method": "POST", "url": "{{baseUrl}}/api/BodyMeasurements/Create",
                "headers": { "Authorization": "Bearer {{user1_token}}", "Content-Type": "application/json" },
                "body": { "weightKg": 82.5, "heightCm": 180.0, "bodyFatPercentage": 18.0, "chestCm": 105.0, "waistCm": 85.0, "armsCm": 38.0, "legsCm": 60.0, "notes": "Flow test measurement" }
            },
            "next": "check-create"
        },
        { "id": "check-create", "type": "condition", "name": "201?", "conditions": [{ "left": "{{create.response.status}}", "operator": "equals", "right": "201" }], "true_next": "capture", "false_next": "fail" },
        { "id": "capture", "type": "set-variable", "name": "Capture ID", "scope": "collection", "variables": [{ "key": "lastBodyMeasurementId", "value": "{{create.response.body.data.id}}" }], "next": "read" },
        { "id": "read", "type": "http", "name": "2. Read By Id", "request": { "method": "GET", "url": "{{baseUrl}}/api/BodyMeasurements/{{lastBodyMeasurementId}}", "headers": { "Authorization": "Bearer {{user1_token}}" } }, "next": "check-read" },
        { "id": "check-read", "type": "condition", "name": "200?", "conditions": [{ "left": "{{read.response.status}}", "operator": "equals", "right": "200" }], "true_next": "update", "false_next": "fail" },
        { "id": "update", "type": "http", "name": "3. Update", "request": { "method": "PUT", "url": "{{baseUrl}}/api/BodyMeasurements/{{lastBodyMeasurementId}}", "headers": { "Authorization": "Bearer {{user1_token}}", "Content-Type": "application/json" }, "body": { "weightKg": 81.0, "heightCm": 180.0, "bodyFatPercentage": 17.5, "chestCm": 106.0, "waistCm": 84.0, "armsCm": 38.5, "legsCm": 61.0, "notes": "Updated" } }, "next": "check-update" },
        { "id": "check-update", "type": "condition", "name": "200?", "conditions": [{ "left": "{{update.response.status}}", "operator": "equals", "right": "200" }], "true_next": "delete", "false_next": "fail" },
        { "id": "delete", "type": "http", "name": "4. Delete", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/BodyMeasurements/{{lastBodyMeasurementId}}", "headers": { "Authorization": "Bearer {{user1_token}}" } }, "next": "check-delete" },
        { "id": "check-delete", "type": "condition", "name": "200?", "conditions": [{ "left": "{{delete.response.status}}", "operator": "equals", "right": "200" }], "true_next": "pass", "false_next": "fail" },
        { "id": "pass", "type": "log", "name": "PASSED", "message": "[BodyMeasurement CRUD] Create→Read→Update→Delete all passed" },
        { "id": "fail", "type": "log", "name": "FAILED", "message": "[BodyMeasurement CRUD] Flow failed" },
        { "id": "end", "type": "end", "name": "End" }
    ]
}
