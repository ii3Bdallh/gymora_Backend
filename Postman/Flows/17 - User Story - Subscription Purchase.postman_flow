{
    "info": {
        "name": "User Story: Subscription & Payment Flow",
        "description": "Complete business flow: List SubscriptionPlans → Create PaymentRequest (with coupon) → Approve Payment → Verify OwnerSubscription created → Get My Current Subscription. Tests the full subscription purchase journey.",
        "schema": "https://schema.getpostman.com/flow/v1/flow.json"
    },
    "flow": [
        { "id": "start", "type": "start", "name": "Start", "next": "list-plans" },
        { "id": "list-plans", "type": "http", "name": "1. List Subscription Plans", "request": { "method": "POST", "url": "{{baseUrl}}/api/SubscriptionPlan", "headers": { "Authorization": "Bearer {{user1_token}}", "Content-Type": "application/json" }, "body": { "pageNumber": 1, "pageSize": 10, "orderBy": "Id", "orderDirection": "asc" } }, "next": "check-plans" },
        { "id": "check-plans", "type": "condition", "name": "200?", "conditions": [{ "left": "{{list-plans.response.status}}", "operator": "equals", "right": "200" }], "true_next": "capture-plan", "false_next": "fail" },
        { "id": "capture-plan", "type": "set-variable", "name": "Capture Plan IDs", "scope": "collection", "variables": [{ "key": "subscriptionPlanId", "value": "{{list-plans.response.body.data.items[0].id}}" }, { "key": "planPriceId", "value": "{{list-plans.response.body.data.items[0].prices[0].id}}" }], "next": "create-coupon" },
        {
            "id": "create-coupon", "type": "http", "name": "2. Create Coupon (SuperAdmin)",
            "request": {
                "method": "POST", "url": "{{baseUrl}}/api/Coupon/Create",
                "headers": { "Authorization": "Bearer {{superAdmin_token}}", "Content-Type": "application/json" },
                "body": { "code": "FLOW20", "name": "Flow Discount", "description": "20% off", "discountType": 1, "discountValue": 20.0, "maxDiscountAmount": 50.0, "minimumPurchaseAmount": 100.0, "usageLimit": 100, "validFrom": "2026-01-01T00:00:00Z", "validTo": "2026-12-31T23:59:59Z", "isFirstPurchaseOnly": false }
            },
            "next": "check-coupon"
        },
        { "id": "check-coupon", "type": "condition", "name": "200?", "conditions": [{ "left": "{{create-coupon.response.status}}", "operator": "equals", "right": "200" }], "true_next": "capture-coupon", "false_next": "skip-coupon" },
        { "id": "capture-coupon", "type": "set-variable", "name": "Capture Coupon ID", "scope": "collection", "variables": [{ "key": "lastCouponId", "value": "{{create-coupon.response.body.data.id}}" }], "next": "validate-coupon" },
        { "id": "validate-coupon", "type": "http", "name": "3. Validate Coupon", "request": { "method": "GET", "url": "{{baseUrl}}/api/Coupon/Validate/FLOW20?orderAmount=300", "headers": { "Authorization": "Bearer {{superAdmin_token}}" } }, "next": "skip-coupon" },
        { "id": "skip-coupon", "type": "http", "name": "4. Create Payment Request", "request": { "method": "POST", "url": "{{baseUrl}}/api/PaymentRequest/Create", "headers": { "Authorization": "Bearer {{user1_token}}" }, "body": { "mode": "formdata", "formdata": [{ "key": "PlanId", "value": "{{subscriptionPlanId}}", "type": "text" }, { "key": "PlanPriceId", "value": "{{planPriceId}}", "type": "text" }, { "key": "CouponCode", "value": "FLOW20", "type": "text" }] } }, "next": "check-payment" },
        { "id": "check-payment", "type": "condition", "name": "200?", "conditions": [{ "left": "{{skip-coupon.response.status}}", "operator": "equals", "right": "200" }], "true_next": "capture-payment", "false_next": "fail" },
        { "id": "capture-payment", "type": "set-variable", "name": "Capture Payment ID", "scope": "collection", "variables": [{ "key": "lastPaymentRequestId", "value": "{{skip-coupon.response.body.data.id}}" }], "next": "approve-payment" },
        { "id": "approve-payment", "type": "http", "name": "5. SuperAdmin Approves Payment", "request": { "method": "PUT", "url": "{{baseUrl}}/api/PaymentRequest/Approve/{{lastPaymentRequestId}}", "headers": { "Authorization": "Bearer {{superAdmin_token}}", "Content-Type": "application/json" }, "body": { "reviewNotes": "Approved via flow" } }, "next": "check-approve" },
        { "id": "check-approve", "type": "condition", "name": "200?", "conditions": [{ "left": "{{approve-payment.response.status}}", "operator": "equals", "right": "200" }], "true_next": "my-subscription", "false_next": "fail" },
        { "id": "my-subscription", "type": "http", "name": "6. Get My Current Subscription", "request": { "method": "GET", "url": "{{baseUrl}}/api/OwnerSubscription/get-my-current-subscription", "headers": { "Authorization": "Bearer {{user1_token}}" } }, "next": "check-subscription" },
        { "id": "check-subscription", "type": "condition", "name": "200?", "conditions": [{ "left": "{{my-subscription.response.status}}", "operator": "equals", "right": "200" }], "true_next": "pass", "false_next": "fail" },
        { "id": "pass", "type": "log", "name": "PASSED", "message": "[User Story: Subscription] Complete flow: ListPlans→CreateCoupon→Validate→CreatePayment→Approve→GetMySubscription all passed" },
        { "id": "fail", "type": "log", "name": "FAILED", "message": "[User Story: Subscription] Flow failed at one of the steps" },
        { "id": "end", "type": "end", "name": "End" }
    ]
}
