{
    "info": {
        "name": "GymPerson Multi-Tenant Security Flow",
        "description": "Verifies gym-scoped isolation for GymPerson: User1 creates a member in Gym A, User2 (Gym B) cannot access it.",
        "schema": "https://schema.getpostman.com/flow/v1/flow.json"
    },
    "flow": [
        { "id": "start", "type": "start", "name": "Start", "next": "create" },
        { "id": "create", "type": "http", "name": "1. User1 Creates GymPerson", "request": { "method": "POST", "url": "{{baseUrl}}/api/GymPerson/Create", "headers": { "Authorization": "Bearer {{user1_token}}", "Content-Type": "application/json" }, "body": { "personType": 1, "name": "Security Test Member", "phoneNumber": "+1234567891", "memberProfile": { "medicalNotes": null, "notes": null } } }, "next": "check-create" },
        { "id": "check-create", "type": "condition", "name": "200?", "conditions": [{ "left": "{{create.response.status}}", "operator": "equals", "right": "200" }], "true_next": "capture", "false_next": "fail" },
        { "id": "capture", "type": "set-variable", "name": "Capture ID", "scope": "collection", "variables": [{ "key": "lastGymPersonId", "value": "{{create.response.body.data.id}}" }], "next": "user2-read" },
        { "id": "user2-read", "type": "http", "name": "2. User2 Tries Read", "request": { "method": "GET", "url": "{{baseUrl}}/api/GymPerson/{{lastGymPersonId}}", "headers": { "Authorization": "Bearer {{user2_token}}" } }, "next": "check-denied" },
        { "id": "check-denied", "type": "condition", "name": "404 or 403?", "conditions": [{ "left": "{{user2-read.response.status}}", "operator": "in", "right": "404,403" }], "true_next": "user2-update", "false_next": "fail" },
        { "id": "user2-update", "type": "http", "name": "3. User2 Tries Update", "request": { "method": "PUT", "url": "{{baseUrl}}/api/GymPerson/{{lastGymPersonId}}", "headers": { "Authorization": "Bearer {{user2_token}}", "Content-Type": "application/json" }, "body": { "personType": 1, "name": "HACKED", "phoneNumber": "000", "memberProfile": null } }, "next": "check-update-denied" },
        { "id": "check-update-denied", "type": "condition", "name": "404 or 403?", "conditions": [{ "left": "{{user2-update.response.status}}", "operator": "in", "right": "404,403" }], "true_next": "user2-delete", "false_next": "fail" },
        { "id": "user2-delete", "type": "http", "name": "4. User2 Tries Delete", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/GymPerson/{{lastGymPersonId}}", "headers": { "Authorization": "Bearer {{user2_token}}" } }, "next": "check-delete-denied" },
        { "id": "check-delete-denied", "type": "condition", "name": "404 or 403?", "conditions": [{ "left": "{{user2-delete.response.status}}", "operator": "in", "right": "404,403" }], "true_next": "cleanup", "false_next": "fail" },
        { "id": "cleanup", "type": "http", "name": "5. User1 Cleanup", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/GymPerson/{{lastGymPersonId}}", "headers": { "Authorization": "Bearer {{user1_token}}" } }, "next": "pass" },
        { "id": "pass", "type": "log", "name": "PASSED", "message": "[GymPerson Security] Gym isolation verified: User2 cannot access User1's gym persons" },
        { "id": "fail", "type": "log", "name": "FAILED", "message": "[GymPerson Security] BREACH: User2 accessed User1's gym-scoped person" },
        { "id": "end", "type": "end", "name": "End" }
    ]
}
