{
    "info": {
        "name": "Expense Multi-Tenant Security Flow",
        "description": "Verifies gym-scoped isolation for Expenses: User1 creates, User2 (different gym) cannot access.",
        "schema": "https://schema.getpostman.com/flow/v1/flow.json"
    },
    "flow": [
        { "id": "start", "type": "start", "name": "Start", "next": "create" },
        { "id": "create", "type": "http", "name": "1. User1 Creates Expense", "request": { "method": "POST", "url": "{{baseUrl}}/api/Expenses/Create", "headers": { "Authorization": "Bearer {{user1_token}}", "Content-Type": "application/json" }, "body": { "expenseCategory": 0, "amount": 500.00, "paymentMethod": 0, "referenceNumber": "SEC-EXP-001", "description": "Security test", "expenseDate": "2026-08-13T00:00:00Z" } }, "next": "check-create" },
        { "id": "check-create", "type": "condition", "name": "201?", "conditions": [{ "left": "{{create.response.status}}", "operator": "equals", "right": "201" }], "true_next": "capture", "false_next": "fail" },
        { "id": "capture", "type": "set-variable", "name": "Capture ID", "scope": "collection", "variables": [{ "key": "lastExpenseId", "value": "{{create.response.body.data.id}}" }], "next": "user2-read" },
        { "id": "user2-read", "type": "http", "name": "2. User2 Tries Read", "request": { "method": "GET", "url": "{{baseUrl}}/api/Expenses/{{lastExpenseId}}", "headers": { "Authorization": "Bearer {{user2_token}}" } }, "next": "check-denied-read" },
        { "id": "check-denied-read", "type": "condition", "name": "404 or 403?", "conditions": [{ "left": "{{user2-read.response.status}}", "operator": "in", "right": "404,403" }], "true_next": "user2-update", "false_next": "fail" },
        { "id": "user2-update", "type": "http", "name": "3. User2 Tries Update", "request": { "method": "PUT", "url": "{{baseUrl}}/api/Expenses/{{lastExpenseId}}", "headers": { "Authorization": "Bearer {{user2_token}}", "Content-Type": "application/json" }, "body": { "expenseCategory": 0, "amount": 99999, "paymentMethod": 0, "referenceNumber": "HACK", "description": "Hack", "expenseDate": "2026-08-13T00:00:00Z" } }, "next": "check-denied-update" },
        { "id": "check-denied-update", "type": "condition", "name": "404 or 403?", "conditions": [{ "left": "{{user2-update.response.status}}", "operator": "in", "right": "404,403" }], "true_next": "user2-delete", "false_next": "fail" },
        { "id": "user2-delete", "type": "http", "name": "4. User2 Tries Delete", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/Expenses/{{lastExpenseId}}", "headers": { "Authorization": "Bearer {{user2_token}}" } }, "next": "check-denied-delete" },
        { "id": "check-denied-delete", "type": "condition", "name": "404 or 403?", "conditions": [{ "left": "{{user2-delete.response.status}}", "operator": "in", "right": "404,403" }], "true_next": "cleanup", "false_next": "fail" },
        { "id": "cleanup", "type": "http", "name": "5. User1 Cleanup", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/Expenses/{{lastExpenseId}}", "headers": { "Authorization": "Bearer {{user1_token}}" } }, "next": "pass" },
        { "id": "pass", "type": "log", "name": "PASSED", "message": "[Expense Security] Gym isolation verified: User2 cannot access User1's expenses" },
        { "id": "fail", "type": "log", "name": "FAILED", "message": "[Expense Security] BREACH: User2 accessed User1's gym-scoped expense" },
        { "id": "end", "type": "end", "name": "End" }
    ]
}
