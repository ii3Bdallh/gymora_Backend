{
    "info": {
        "name": "Gym CRUD Flow",
        "description": "Tests Gym lifecycle: List → Create (form-data) → Read → Update → Get User Gyms → Change Owner → Delete. Platform-level resource.",
        "schema": "https://schema.getpostman.com/flow/v1/flow.json"
    },
    "flow": [
        { "id": "start", "type": "start", "name": "Start", "next": "list" },
        { "id": "list", "type": "http", "name": "1. List Gyms", "request": { "method": "POST", "url": "{{baseUrl}}/api/Gym", "headers": { "Authorization": "Bearer {{user1_token}}", "Content-Type": "application/json" }, "body": { "pageNumber": 1, "pageSize": 10, "orderBy": "Id", "orderDirection": "asc" } }, "next": "check-list" },
        { "id": "check-list", "type": "condition", "name": "200?", "conditions": [{ "left": "{{list.response.status}}", "operator": "equals", "right": "200" }], "true_next": "create", "false_next": "fail" },
        { "id": "create", "type": "http", "name": "2. Create Gym", "request": { "method": "POST", "url": "{{baseUrl}}/api/Gym/Create", "headers": { "Authorization": "Bearer {{user1_token}}" }, "body": { "mode": "formdata", "formdata": [{ "key": "Name", "value": "Flow Test Gym", "type": "text" }, { "key": "Description", "value": "Flow test", "type": "text" }, { "key": "PhoneNumber", "value": "+1234567890", "type": "text" }, { "key": "Email", "value": "flow@gym.com", "type": "text" }, { "key": "City", "value": "Cairo", "type": "text" }, { "key": "Status", "value": "1", "type": "text" }] } }, "next": "check-create" },
        { "id": "check-create", "type": "condition", "name": "200?", "conditions": [{ "left": "{{create.response.status}}", "operator": "equals", "right": "200" }], "true_next": "capture", "false_next": "fail" },
        { "id": "capture", "type": "set-variable", "name": "Capture Gym ID", "scope": "collection", "variables": [{ "key": "lastGymId", "value": "{{create.response.body.data.id}}" }], "next": "read" },
        { "id": "read", "type": "http", "name": "3. Read Gym", "request": { "method": "GET", "url": "{{baseUrl}}/api/Gym/{{lastGymId}}", "headers": { "Authorization": "Bearer {{user1_token}}" } }, "next": "check-read" },
        { "id": "check-read", "type": "condition", "name": "200?", "conditions": [{ "left": "{{read.response.status}}", "operator": "equals", "right": "200" }], "true_next": "update", "false_next": "fail" },
        { "id": "update", "type": "http", "name": "4. Update Gym", "request": { "method": "PUT", "url": "{{baseUrl}}/api/Gym/{{lastGymId}}", "headers": { "Authorization": "Bearer {{user1_token}}" }, "body": { "mode": "formdata", "formdata": [{ "key": "Name", "value": "Flow Test Gym Updated", "type": "text" }, { "key": "Status", "value": "1", "type": "text" }] } }, "next": "check-update" },
        { "id": "check-update", "type": "condition", "name": "200?", "conditions": [{ "left": "{{update.response.status}}", "operator": "equals", "right": "200" }], "true_next": "user-gyms", "false_next": "fail" },
        { "id": "user-gyms", "type": "http", "name": "5. Get User Gyms", "request": { "method": "GET", "url": "{{baseUrl}}/api/Gym/user-gyms?pageNumber=1&pageSize=10", "headers": { "Authorization": "Bearer {{user1_token}}" } }, "next": "check-user-gyms" },
        { "id": "check-user-gyms", "type": "condition", "name": "200?", "conditions": [{ "left": "{{user-gyms.response.status}}", "operator": "equals", "right": "200" }], "true_next": "delete", "false_next": "fail" },
        { "id": "delete", "type": "http", "name": "6. Delete Gym", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/Gym/{{lastGymId}}", "headers": { "Authorization": "Bearer {{user1_token}}" } }, "next": "check-delete" },
        { "id": "check-delete", "type": "condition", "name": "200?", "conditions": [{ "left": "{{delete.response.status}}", "operator": "equals", "right": "200" }], "true_next": "pass", "false_next": "fail" },
        { "id": "pass", "type": "log", "name": "PASSED", "message": "[Gym CRUD] List→Create→Read→Update→UserGyms→Delete all passed" },
        { "id": "fail", "type": "log", "name": "FAILED", "message": "[Gym CRUD] Flow failed" },
        { "id": "end", "type": "end", "name": "End" }
    ]
}
