{
    "info": {
        "name": "Financial Report Flow",
        "description": "Tests FinancialReports: Revenue Report → Expense Report with date range filtering. Gym-scoped with route gymId validation.",
        "schema": "https://schema.getpostman.com/flow/v1/flow.json"
    },
    "flow": [
        { "id": "start", "type": "start", "name": "Start", "next": "revenue-report" },
        { "id": "revenue-report", "type": "http", "name": "1. Get Revenue Report", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/gyms/{{gymId}}/finances/reports/revenue?fromDate=2026-01-01T00:00:00Z&toDate=2026-12-31T23:59:59Z", "headers": { "Authorization": "Bearer {{user1_token}}" } }, "next": "check-revenue" },
        { "id": "check-revenue", "type": "condition", "name": "200?", "conditions": [{ "left": "{{revenue-report.response.status}}", "operator": "equals", "right": "200" }], "true_next": "expense-report", "false_next": "fail" },
        { "id": "expense-report", "type": "http", "name": "2. Get Expense Report", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/gyms/{{gymId}}/finances/reports/expense?fromDate=2026-01-01T00:00:00Z&toDate=2026-12-31T23:59:59Z", "headers": { "Authorization": "Bearer {{user1_token}}" } }, "next": "check-expense" },
        { "id": "check-expense", "type": "condition", "name": "200?", "conditions": [{ "left": "{{expense-report.response.status}}", "operator": "equals", "right": "200" }], "true_next": "verify-revenue-fields", "false_next": "fail" },
        { "id": "verify-revenue-fields", "type": "condition", "name": "Has totalRevenue?", "conditions": [{ "left": "{{revenue-report.response.body.data.totalRevenue}}", "operator": "exists" }], "true_next": "verify-expense-fields", "false_next": "fail" },
        { "id": "verify-expense-fields", "type": "condition", "name": "Has totalExpense?", "conditions": [{ "left": "{{expense-report.response.body.data.totalExpense}}", "operator": "exists" }], "true_next": "pass", "false_next": "fail" },
        { "id": "pass", "type": "log", "name": "PASSED", "message": "[Financial Reports] Revenue & Expense reports returned with valid data" },
        { "id": "fail", "type": "log", "name": "FAILED", "message": "[Financial Reports] Flow failed" },
        { "id": "end", "type": "end", "name": "End" }
    ]
}
