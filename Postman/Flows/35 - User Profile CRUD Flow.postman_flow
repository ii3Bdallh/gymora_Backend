{
    "info": {
        "name": "User Profile CRUD Flow",
        "description": "Tests UserProfile lifecycle: Get → Update → Get → Verify. Tests that profile data is persisted correctly.",
        "schema": "https://schema.getpostman.com/flow/v1/flow.json"
    },
    "flow": [
        { "id": "start", "type": "start", "name": "Start", "next": "get-profile" },
        { "id": "get-profile", "type": "http", "name": "1. Get Profile", "request": { "method": "GET", "url": "{{baseUrl}}/api/UserProfile", "headers": { "Authorization": "Bearer {{user1_token}}" } }, "next": "check-get" },
        { "id": "check-get", "type": "condition", "name": "200?", "conditions": [{ "left": "{{get-profile.response.status}}", "operator": "equals", "right": "200" }], "true_next": "update-profile", "false_next": "fail" },
        { "id": "update-profile", "type": "http", "name": "2. Update Profile", "request": { "method": "PUT", "url": "{{baseUrl}}/api/UserProfile/Update", "headers": { "Authorization": "Bearer {{user1_token}}", "Content-Type": "application/json" }, "body": { "firstName": "Flow", "lastName": "TestUser", "dateOfBirth": "1990-01-01T00:00:00Z", "gender": "Male" } }, "next": "check-update" },
        { "id": "check-update", "type": "condition", "name": "200?", "conditions": [{ "left": "{{update-profile.response.status}}", "operator": "equals", "right": "200" }], "true_next": "verify", "false_next": "fail" },
        { "id": "verify", "type": "http", "name": "3. Verify Updated", "request": { "method": "GET", "url": "{{baseUrl}}/api/UserProfile", "headers": { "Authorization": "Bearer {{user1_token}}" } }, "next": "check-verify" },
        { "id": "check-verify", "type": "condition", "name": "200?", "conditions": [{ "left": "{{verify.response.status}}", "operator": "equals", "right": "200" }], "true_next": "pass", "false_next": "fail" },
        { "id": "pass", "type": "log", "name": "PASSED", "message": "[UserProfile CRUD] Get→Update→Verify all passed" },
        { "id": "fail", "type": "log", "name": "FAILED", "message": "[UserProfile CRUD] Flow failed" },
        { "id": "end", "type": "end", "name": "End" }
    ]
}
