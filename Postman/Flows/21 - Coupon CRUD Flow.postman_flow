{
    "info": {
        "name": "Coupon CRUD & Validation Flow",
        "description": "Tests Coupon lifecycle: SuperAdmin creates → Read → Validate → Update → Delete. Also tests non-SuperAdmin cannot access.",
        "schema": "https://schema.getpostman.com/flow/v1/flow.json"
    },
    "flow": [
        { "id": "start", "type": "start", "name": "Start", "next": "create" },
        {
            "id": "create", "type": "http", "name": "1. Create Coupon (SuperAdmin)",
            "request": {
                "method": "POST", "url": "{{baseUrl}}/api/Coupon/Create",
                "headers": { "Authorization": "Bearer {{superAdmin_token}}", "Content-Type": "application/json" },
                "body": { "code": "FLOW10", "name": "Flow Coupon", "description": "10% off", "discountType": 1, "discountValue": 10.0, "maxDiscountAmount": 30.0, "minimumPurchaseAmount": 50.0, "usageLimit": 50, "validFrom": "2026-01-01T00:00:00Z", "validTo": "2026-12-31T23:59:59Z", "isFirstPurchaseOnly": false }
            },
            "next": "check-create"
        },
        { "id": "check-create", "type": "condition", "name": "200?", "conditions": [{ "left": "{{create.response.status}}", "operator": "equals", "right": "200" }], "true_next": "capture", "false_next": "fail" },
        { "id": "capture", "type": "set-variable", "name": "Capture ID", "scope": "collection", "variables": [{ "key": "lastCouponId", "value": "{{create.response.body.data.id}}" }], "next": "read" },
        { "id": "read", "type": "http", "name": "2. Read Coupon", "request": { "method": "GET", "url": "{{baseUrl}}/api/Coupon/{{lastCouponId}}", "headers": { "Authorization": "Bearer {{superAdmin_token}}" } }, "next": "check-read" },
        { "id": "check-read", "type": "condition", "name": "200?", "conditions": [{ "left": "{{read.response.status}}", "operator": "equals", "right": "200" }], "true_next": "validate", "false_next": "fail" },
        { "id": "validate", "type": "http", "name": "3. Validate Coupon", "request": { "method": "GET", "url": "{{baseUrl}}/api/Coupon/Validate/FLOW10?orderAmount=200", "headers": { "Authorization": "Bearer {{superAdmin_token}}" } }, "next": "check-validate" },
        { "id": "check-validate", "type": "condition", "name": "200?", "conditions": [{ "left": "{{validate.response.status}}", "operator": "equals", "right": "200" }], "true_next": "update", "false_next": "fail" },
        { "id": "update", "type": "http", "name": "4. Update Coupon", "request": { "method": "PUT", "url": "{{baseUrl}}/api/Coupon/{{lastCouponId}}", "headers": { "Authorization": "Bearer {{superAdmin_token}}", "Content-Type": "application/json" }, "body": { "name": "Flow Coupon Updated", "discountValue": 15.0, "isActive": true } }, "next": "check-update" },
        { "id": "check-update", "type": "condition", "name": "200?", "conditions": [{ "left": "{{update.response.status}}", "operator": "equals", "right": "200" }], "true_next": "non-sa-test", "false_next": "fail" },
        { "id": "non-sa-test", "type": "http", "name": "5. Non-SA Tries List (Expect 403)", "request": { "method": "POST", "url": "{{baseUrl}}/api/Coupon", "headers": { "Authorization": "Bearer {{user1_token}}", "Content-Type": "application/json" }, "body": { "pageNumber": 1, "pageSize": 10, "orderBy": "Id", "orderDirection": "asc" } }, "next": "check-forbidden" },
        { "id": "check-forbidden", "type": "condition", "name": "403?", "conditions": [{ "left": "{{non-sa-test.response.status}}", "operator": "equals", "right": "403" }], "true_next": "delete", "false_next": "fail" },
        { "id": "delete", "type": "http", "name": "6. Delete Coupon", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/Coupon/{{lastCouponId}}", "headers": { "Authorization": "Bearer {{superAdmin_token}}" } }, "next": "check-delete" },
        { "id": "check-delete", "type": "condition", "name": "200?", "conditions": [{ "left": "{{delete.response.status}}", "operator": "equals", "right": "200" }], "true_next": "pass", "false_next": "fail" },
        { "id": "pass", "type": "log", "name": "PASSED", "message": "[Coupon CRUD] Create→Read→Validate→Update→NonSA-403→Delete all passed" },
        { "id": "fail", "type": "log", "name": "FAILED", "message": "[Coupon CRUD] Flow failed" },
        { "id": "end", "type": "end", "name": "End" }
    ]
}
